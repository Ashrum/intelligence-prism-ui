{
  "name": "@ole/ui",
  "version": "0.3.0",
  "description": "OLE UI components and Smart Prism theme for React 19",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "LICENSE",
    "SOURCE.md",
    "src/particles/LICENSE",
    "src/particles/SOURCE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scoped-overlays": {
      "types": "./dist/scoped-overlays.d.ts",
      "import": "./dist/scoped-overlays.js"
    },
    "./styles/theme.css": "./styles/theme.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/theme-workbench.css": "./styles/theme-workbench.css",
    "./styles/ruler.css": "./styles/ruler.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.80.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.24.2",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  }
}

+const cache = new Map();
+function parse(s) {
+  if (cache.has(s)) return cache.get(s);
+  let result;
+  transform({ code: Buffer.from(`${s}{color:red}`), visitor: { Selector(ast) { result = ast; } } });
+  assert.ok(result); cache.set(s, result); return result;
